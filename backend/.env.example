# ==============================================================================
# GrantBridge AI — Backend Environment Variables
# Copy this file to backend/.env and fill in your real credentials.
# NEVER commit .env files with real secrets to version control.
# ==============================================================================

# Neon Serverless PostgreSQL connection string (SSL required)
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Firecrawl API v2 key for live web scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# Google Gemini API key for extraction, grant matching & English proposal drafting
# (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Nvoip API key for SMS / WhatsApp alerts to Brazilian community leaders
# (https://nvoip.com.br)
NVOIP_API_KEY=your-nvoip-api-key

# Optional: override Nvoip v3 endpoint (defaults to https://api.nvoip.com.br/v3/sms)
# NVOIP_API_URL=https://api.nvoip.com.br/v3/sms

# Optional: override Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
